# Copy to .env.production and fill in real values.
# Used by docker-compose (api service) via `env_file`.

# Server Configuration
NODE_ENV=production
# PORT is ignored in production — fixed to 5090 in src/config/app.config.ts.
PORT=5090
API_PREFIX=/patchwork/api

# Database Configuration (MariaDB/MySQL)
# DATABASE_HOST must be the MySQL container's service name on the shared
# Docker network (see mysql-shared/docker-compose.yml), not 127.0.0.1 —
# containers can't reach the host's localhost by that address.
DATABASE_URL=mysql://patchwork_prod:your_password@mysql-shared:3306/patchwork_prod
DATABASE_HOST=mysql-shared
DATABASE_PORT=3306
DATABASE_USER=patchwork_prod
DATABASE_PASSWORD=your_password
DATABASE_NAME=patchwork_prod

# CORS Configuration — production domain(s) only, comma-separated
CORS_ORIGIN=https://your-production-domain

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM_NAME=Embroidery Business System
EMAIL_FROM_ADDRESS=noreply@embroidery.com

# OTP Configuration
OTP_EXPIRY_MINUTES=10

# Frontend URL (for password reset links)
FRONTEND_URL=https://your-production-domain

# Other configurations
LOG_LEVEL=info

# JWT Configuration
JWT_SECRET=yourStrongProductionSecretHere
JWT_EXPIRES_IN=15m
