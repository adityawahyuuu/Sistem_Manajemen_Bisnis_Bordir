# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database Configuration (MariaDB/MySQL)
DATABASE_URL=mysql://development:your_password@your_host:3306/embroidery_db
DATABASE_HOST=your_host
DATABASE_PORT=3306
DATABASE_USER=development
DATABASE_PASSWORD=your_password
DATABASE_NAME=embroidery_db

# CORS Configuration
CORS_ORIGIN=http://your_host:3000,http://your_host:5173

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM_NAME=Embroidery Business System
EMAIL_FROM_ADDRESS=noreply@embroidery.com

# OTP Configuration
OTP_EXPIRY_MINUTES=10

# Frontend URL (for password reset links)
FRONTEND_URL=http://your_host:3000

# Other configurations
LOG_LEVEL=info

# JWT Configuration
JWT_SECRET=yourStrongSecretHere
JWT_EXPIRES_IN=15m